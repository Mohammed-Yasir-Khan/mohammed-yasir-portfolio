# Copy to .env and fill in. Never commit .env.

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000

# Where contact-form messages are delivered
CONTACT_TO_EMAIL=you@example.com

# SMTP (leave SMTP_HOST empty in dev: messages are saved to data/messages.jsonl instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portfolio@example.com

# Rate limit: max contact submissions per IP per hour
CONTACT_RATE_LIMIT_PER_HOUR=5
